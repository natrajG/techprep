POSTGRES_DB=interview_ai
POSTGRES_USER=interview_user
POSTGRES_PASSWORD=change_me
OPENAI_API_KEY=
# Optional OpenAI-compatible provider. Tested Groq config:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-120b  STT_MODEL=whisper-large-v3
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
STT_MODEL=whisper-1

# Google "Sign in with Google" OAuth Client ID (Google Cloud Console > APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
# Secret for the same OAuth client. Needed only so the desktop app can offer Google sign-in (Google
# blocks it inside the desktop app's embedded window, so it opens the system browser instead and
# this server exchanges the resulting code for tokens). Also add this server's own
# /api/v1/auth/google/desktop/callback URL to the client's "Authorized redirect URIs". Leave blank
# to hide the Google button in the desktop app only; the web button still works.
GOOGLE_CLIENT_SECRET=

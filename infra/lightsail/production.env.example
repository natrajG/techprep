# Copy to production.env on the server (chmod 600). Never commit the real file.
# deploy.sh refuses to start while any value still contains "REPLACE".

# Public HTTPS address; must match TECHPREP_HOST in .env.
APP_PUBLIC_URL=https://REPLACE.example.org

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET

# Razorpay API keys; enable automatic capture in the Razorpay dashboard.
# Only captured INR payments matching the full order amount activate subscriptions.
RAZORPAY_KEY_ID=REPLACE_WITH_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_KEY_SECRET
ENFORCE_SUBSCRIPTIONS=true

# Bootstrap administrator (password at least 12 characters).
APP_USERNAME=admin
APP_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Initial invite-only pilot: keep sign-up off until email address verification exists.
ALLOW_SIGNUP=false
# Set to true only after the TechPrep Store listing is published and installable.
STORE_APP_PUBLISHED=false

OPENAI_API_KEY=REPLACE_WITH_PROVIDER_KEY
# Optional OpenAI-compatible provider settings.
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
STT_MODEL=whisper-1

AUTH_TOKEN_TTL_HOURS=12
# Failed sign-ins allowed per username and address in the window below (successful sign-ins never count).
AUTH_RATE_LIMIT_ATTEMPTS=10
# Ceiling on all sign-in attempts from one address, so shared office or campus addresses keep working.
AUTH_RATE_LIMIT_IP_ATTEMPTS=500
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AI_REQUESTS_PER_MINUTE=30
# Counted per worker (WEB_CONCURRENCY, default 2), so the effective ceiling is this value times the workers.

# "Forgot password?" emails. Works with any SMTP service; for AWS SES use the SMTP endpoint of your region
# (email-smtp.<region>.amazonaws.com, port 587) with SMTP credentials and a verified sender.
# Leave both empty to hide the feature.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# Where new user feedback submissions (bug reports/suggestions) are emailed to.
# Leave empty to silently skip the notification email (feedback is still saved either way).
FEEDBACK_NOTIFY_EMAIL=

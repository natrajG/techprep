# Copy to production.env on the server (chmod 600). Never commit the real file.
# deploy.sh refuses to start while any value still contains "REPLACE".

# Public HTTPS address; must match TECHPREP_HOST in .env.
APP_PUBLIC_URL=https://REPLACE.example.org

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET

# Bootstrap administrator (password at least 12 characters).
APP_USERNAME=admin
APP_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Initial invite-only pilot: keep sign-up off until email verification/reset exist.
ALLOW_SIGNUP=false
# Set to true only after the TechPrep Store listing is published and installable.
STORE_APP_PUBLISHED=false

OPENAI_API_KEY=REPLACE_WITH_PROVIDER_KEY
# Optional OpenAI-compatible provider settings.
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
STT_MODEL=whisper-1

AUTH_TOKEN_TTL_HOURS=12
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AI_REQUESTS_PER_MINUTE=30
